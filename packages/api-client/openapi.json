  "info": {
    "title": "Foresee Reservation API",
    "description": "Booking and operations API for Foresee Corporation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "health",
      "description": ""
    },
    {
      "name": "bookings",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@forsee.example"
          },
          "password": {
            "type": "string",
            "example": "demo1234",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AvailabilityQueryDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "example": "2026-09-01"
          },
          "serviceCode": {
            "type": "string",
            "example": "GREASE_TRAP"
          },
          "customerSiteId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "date",
          "serviceCode"
        ]
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "serviceCode": {
            "type": "string",
            "example": "GREASE_TRAP"
          },
          "customerSiteId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedDate": {
            "type": "string",
            "example": "2026-09-01"
          },
          "requestedStart": {
            "type": "string",
            "example": "09:00"
          },
          "requestedEnd": {
            "type": "string",
            "example": "11:30"
          },
          "estimatedVolume": {
            "type": "number",
            "example": 4
          },
          "customerNote": {
            "type": "string",
            "example": "เข้าทางประตูฝั่งตะวันออก"
          }
        },
        "required": [
          "serviceCode",
          "customerSiteId",
          "requestedDate",
          "requestedStart",
          "requestedEnd"
        ]
      },
      "AssignBookingDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "format": "uuid"
          },
          "driverUserId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "example": "รถคันเดิมเข้าซ่อม"
          }
        },
        "required": [
          "vehicleId"
        ]
      }
    }
  }
}
